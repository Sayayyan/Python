nilaitugas = float(input('Masukkan nilai Tugas : '))
nilaiuts = float(input('Masukkan nilai UTS : '))
nilaiuas = float(input('Masukkan nilai UAS : '))

nilaiakhir = (0.3 * nilaitugas) + (0.4 * nilaiuts) + (0.3 * nilaiuas)

if nilaiakhir >= 80:
    print('Selamat anda dinyatakan lulus dengan nilai ', nilaiakhir)
else:
    print('Maaf, anda tidak lulus, nilai anda : ', nilaiakhir)